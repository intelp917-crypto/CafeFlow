# ============================================================================
# CafeFlow — تنظیمات نهایی تولید (ایمیج تک‌سرویسی)
# ----------------------------------------------------------------------------
# این فایل فقط برای اجرای ایمیج است، نه توسعهٔ محلی.
#   docker run ... --env-file deploy.env.example ...
# یا محتوای آن را در پنل هاست Docker به‌صورت متغیرهای محیطی وارد کنید.
#
# فقط یک مقدار را باید عوض کنید: SEED_ADMIN_PASSWORD
# همهٔ مسیرها از قبل داخل ایمیج درست تنظیم شده‌اند؛ آن‌ها را با مقادیر توسعه
# (مثل ../../data) جایگزین نکنید.
# ============================================================================

# --- اجرا -------------------------------------------------------------------
APP_ENV=production
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
API_PREFIX=/api/v1
WEB_ROOT=/app/public
RUST_LOG=cafeflow_api=info,tower_http=warn,sqlx=warn

# --- دادهٔ پایدار (volume را روی /app/data مانت کنید) ------------------------
CAFEFLOW_DATA_DIR=/app/data
CAFEFLOW_BACKUP_DIR=/app/data/backups
DATABASE_PATH=/app/data/cafeflow.db
# entrypoint قبل از serve مهاجرت/seed را اجرا می‌کند؛ برای دیتابیس مشترک چند replica صفر کنید.
CAFEFLOW_AUTO_SETUP=1

# --- پایگاه داده -------------------------------------------------------------
# sqlite (پیش‌فرض، همان کانتینر) | postgres (سرور جدا؛ بلوک پایین را ببینید)
DB_DRIVER=sqlite
DB_AUTO_MIGRATE=true
DB_POOL_MAX=1

# برای PostgreSQL این دو خط را از حالت توضیح خارج و sqlite را جایگزین کنید:
# DB_DRIVER=postgres
# DB_POOL_MAX=10
# DATABASE_URL=postgres://cafeflow:CHANGE_ME@db-host:5432/cafeflow

# --- نشست و ورود ------------------------------------------------------------
SESSION_COOKIE_NAME=cafe_session
SESSION_TTL_HOURS=168
# با HTTPS روی true بماند. فقط برای آزمایش موقت روی HTTP خام false کنید،
# وگرنه ورود «نمی‌چسبد».
SESSION_COOKIE_SECURE=true
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# --- داده اولیه ------------------------------------------------------------
# مدیر اصلی از ویزارد /staff/login ساخته می‌شود؛ این دو را خالی بگذارید.
# فقط برای سازگاری با نصب قبلی می‌توانید مقدار بدهید.
SEED_ADMIN_USERNAME=
SEED_ADMIN_PASSWORD=
# کلید ویزارد ساخت مدیر (پیش‌فرض همین است).
CAFEFLOW_INSTALL_KEY=P70w4EslWwiFvmay6Bs1
# در تولید حساب‌های نمونه با گذرواژهٔ شناخته‌شده نسازید.
SEED_DEMO_STAFF=false
# منوی نمونه و میزهای نمایشی؛ برای شروع با منوی خالی false کنید.
SEED_DEMO_MENU=true

# --- اختیاری -----------------------------------------------------------------
# آدرس عمومی سایت برای لینک داخل QR وقتی پنل از دامنه باز نمی‌شود:
# PUBLIC_APP_URL=https://cafe.example.com
