# Copy to `.env` in this folder before `docker compose up -d`.
# Every value here is read by compose.yml; SEED_ADMIN_PASSWORD has no default.

# Required: password of the first administrator (only used while no user exists).
SEED_ADMIN_PASSWORD=change-this-before-first-start

# Name of the Docker volume that holds the database, product uploads and
# backups. It is mounted at /app/data inside the API container.
DATA_VOLUME_NAME=data

# Host ports.
WEB_PORT=8080
HTTP_PORT=80
HTTPS_PORT=8443

# Optional HTTPS profile (`docker compose --profile tls up -d`).
# For a public domain set CAFEFLOW_HOST and CAFEFLOW_TLS to the ACME e-mail;
# keep `internal` for a LAN/local trial with Caddy's own CA.
CAFEFLOW_HOST=localhost
CAFEFLOW_TLS=internal

# Secure cookies must stay true in production; set false only for a plain-HTTP trial.
# Opening the stack from another device (http://<lan-ip>:8080) REQUIRES false:
# a Secure cookie is refused over plain HTTP on anything but localhost, so the
# login would silently never stick.
SESSION_COOKIE_SECURE=true

# Daily backups kept on the backups volume.
BACKUP_KEEP=14

# Demo staff accounts are off in a real installation.
SEED_DEMO_STAFF=false
