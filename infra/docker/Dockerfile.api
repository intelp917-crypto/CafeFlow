# CafeFlow API image
# Built and run on Docker Desktop (Linux engine) on 2026-11-20. See
# docs/11-deployment.md for the verified compose workflow.

FROM node:24-slim AS build
WORKDIR /app

# better-sqlite3 ships prebuilt binaries for this Node line, so no compiler
# toolchain is needed; if a future Node version lacks a prebuild, npm ci fails
# loudly here and `python3 make g++` can be added back for node-gyp.
COPY package.json package-lock.json tsconfig.base.json ./
COPY packages/shared/package.json packages/shared/
COPY packages/games/package.json packages/games/
COPY packages/ui/package.json packages/ui/
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
RUN npm ci --workspace @cafeflow/shared --workspace @cafeflow/games --workspace @cafeflow/api --include-workspace-root

COPY packages/shared packages/shared
COPY packages/games packages/games
COPY apps/api apps/api
RUN npm run build:shared && npm run build:games && npm run build -w @cafeflow/api

FROM node:24-slim AS runtime
ENV NODE_ENV=production
WORKDIR /app

COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/package.json ./package.json
COPY --from=build /app/packages/shared/package.json packages/shared/package.json
COPY --from=build /app/packages/shared/dist packages/shared/dist
COPY --from=build /app/packages/games/package.json packages/games/package.json
COPY --from=build /app/packages/games/dist packages/games/dist
COPY --from=build /app/packages/games/LICENSE packages/games/LICENSE
COPY --from=build /app/packages/games/NOTICE packages/games/NOTICE
COPY --from=build /app/apps/api/package.json apps/api/package.json
COPY --from=build /app/apps/api/dist apps/api/dist
COPY --from=build /app/apps/api/migrations apps/api/migrations
# The daily backup job reuses this image, so the script and better-sqlite3 are
# already present and no package is installed at runtime.
COPY scripts/backup.mjs scripts/backup.mjs

# Runtime state (database + WAL, uploads, backups, print receipts) lives on
# one volume at /app/data — the same root the API resolves by default from
# /app/apps/api. A fresh named volume inherits this folder's ownership from the
# image, so the unprivileged `node` user can write to it.
RUN mkdir -p /app/data/backups /app/data/print-output \
    && chown -R node:node /app/data /app
USER node
ENV CAFEFLOW_DATA_DIR=/app/data
ENV CAFEFLOW_BACKUP_DIR=/app/data/backups
EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:3000/api/v1/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

WORKDIR /app/apps/api
CMD ["node", "dist/main.js"]
