# ---------------------------------------------------------------
# CafeFlow environment configuration
# Copy to .env and adjust. Never commit a real .env file.
# ---------------------------------------------------------------

NODE_ENV=development

# API server
PORT=3000
# Interface to bind. 0.0.0.0 (default) makes the API reachable from the local
# network, which a phone on the same Wi-Fi needs; 127.0.0.1 keeps it local only.
HOST=0.0.0.0
# Public base path of the REST API (the web app proxies this in dev)
API_PREFIX=/api/v1

# Persistent state root: the SQLite file, its WAL, backups and print receipts.
# Development default: the repository's data/ folder.
# On a server ALWAYS set an absolute path on persistent disk, e.g.:
#   CAFEFLOW_DATA_DIR=/var/lib/cafeflow
CAFEFLOW_DATA_DIR=../../data
# Optional explicit overrides (default: $CAFEFLOW_DATA_DIR/cafeflow.db)
# DATABASE_PATH=
# CAFEFLOW_BACKUP_DIR=/var/lib/cafeflow/backups
# Receipts written by scripts/print-bridge.mjs (default: $CAFEFLOW_DATA_DIR/print-output)
# PRINT_OUTPUT_DIR=/var/lib/cafeflow/print-output

# Sessions
SESSION_COOKIE_NAME=cafe_session
SESSION_TTL_HOURS=168
# Set to true when the app is served over HTTPS (production)
SESSION_COOKIE_SECURE=false

# Login throttling
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Seed credentials (Phase 1 bootstrap only - change after first login)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=CafeFlow@1404
SEED_DEMO_STAFF=true
# The starter menu is also the only way to get products today (no catalog UI).
SEED_DEMO_MENU=true

# Optional integrations (leave empty to disable; the platform never blocks
# on a missing provider)
SMS_PROVIDER=                      # kavenegar | smsir | log
SMS_API_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
PRINT_BRIDGE_TOKEN=
